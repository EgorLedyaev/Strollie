{
	"name": "strollie",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"clear": "expo start --clear",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "node ./scripts/run-jest.js --coverage=false",
		"test:all": "node ./scripts/run-jest.js --coverage=false",
		"test:ci": "node ./scripts/run-jest.js --ci --coverage=false",
		"test:changed": "node ./scripts/run-jest.js --watch --coverage=false --changedSince=origin/master",
		"testDebug": "node ./scripts/run-jest.js -o --watch --coverage=false",
		"testFinal": "node ./scripts/run-jest.js --coverage=false",
		"updateSnapshots": "node ./scripts/run-jest.js -u --coverage=false",
		"lint": "expo lint -- --cache --cache-location .cache/eslint/.eslintcache",
		"lint:fix": "expo lint -- --fix --cache --cache-location .cache/eslint/.eslintcache",
		"format": "prettier --cache --cache-location .cache/prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
		"format:check": "prettier --cache --cache-location .cache/prettier --check --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
		"typecheck": "tsc --noEmit",
		"fsd:check": "steiger ./src",
		"fsd:warn": "steiger ./src || true",
		"prepare": "husky",
		"api:sync": "node ./scripts/sync-openapi.js",
		"api:check": "node ./scripts/sync-openapi.js --check"
	},
	"dependencies": {
		"@expo/config-plugins": "~10.1.2",
		"@expo/vector-icons": "^14.1.0",
		"@gorhom/bottom-sheet": "^4",
		"@hookform/resolvers": "^5.2.2",
		"@react-native-async-storage/async-storage": "2.1.2",
		"@react-native-community/netinfo": "^11.4.1",
		"@react-native-community/slider": "4.5.6",
		"@react-navigation/bottom-tabs": "^7.3.10",
		"@react-navigation/drawer": "^7.3.9",
		"@react-navigation/native": "^7.1.6",
		"@shopify/react-native-skia": "^2.2.0",
		"@tanstack/query-async-storage-persister": "^5.90.12",
		"@tanstack/react-query": "^5.90.10",
		"@tanstack/react-query-persist-client": "^5.90.12",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"axios": "^1.13.2",
		"date-fns": "^4.1.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-native": "^5.0.0",
		"expo": "^53.0.22",
		"expo-auth-session": "~6.2.1",
		"expo-blur": "~14.1.5",
		"expo-build-properties": "~0.14.8",
		"expo-constants": "~17.1.7",
		"expo-crypto": "~14.1.5",
		"expo-dev-client": "~5.2.4",
		"expo-document-picker": "~13.1.6",
		"expo-font": "~13.3.2",
		"expo-haptics": "~14.1.4",
		"expo-image-picker": "^16.1.4",
		"expo-json-utils": "^0.15.0",
		"expo-linear-gradient": "~14.1.5",
		"expo-linking": "~7.1.7",
		"expo-location": "~18.1.6",
		"expo-manifests": "^0.16.6",
		"expo-router": "~5.1.4",
		"expo-secure-store": "~14.2.3",
		"expo-splash-screen": "^0.30.10",
		"expo-status-bar": "~2.2.3",
		"expo-symbols": "^0.4.5",
		"expo-system-ui": "~5.0.10",
		"expo-web-browser": "~14.2.0",
		"jotai": "^2.12.5",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-hook-form": "^7.66.1",
		"react-native": "0.79.5",
		"react-native-appmetrica-next": "^2.8.4",
		"react-native-calendars": "^1.1313.0",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-edge-to-edge": "^1.6.2",
		"react-native-gesture-handler": "~2.24.0",
		"react-native-get-random-values": "^1.11.0",
		"react-native-keyboard-controller": "^1.18.2",
		"react-native-popover-view": "^6.1.0",
		"react-native-reanimated": "~3.17.4",
		"react-native-reanimated-carousel": "^4.0.3",
		"react-native-safe-area-context": "5.4.0",
		"react-native-screens": "~4.11.1",
		"react-native-svg": "15.11.2",
		"react-native-web": "^0.20.0",
		"react-native-webview": "^13.15.0",
		"uuid": "^11.1.0",
		"zod": "^4.1.13",
		"expo-sensors": "~14.1.4"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@feature-sliced/steiger-plugin": "^0.5.7",
		"@ianvs/prettier-plugin-sort-imports": "^4.5.1",
		"@testing-library/react-native": "^12.7.2",
		"@types/jest": "^30.0.0",
		"@types/react": "19.0.10",
		"@types/react-native-calendars": "^1.1264.7",
		"@types/uuid": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.3",
		"husky": "^9.1.7",
		"jest": "~29.7.0",
		"jest-expo": "~53.0.10",
		"lint-staged": "^15.2.10",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"react-test-renderer": "19.0.0",
		"steiger": "^0.5.9",
		"typescript": "~5.8.3"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx,js,jsx,json}": [
			"prettier --write",
			"expo lint --fix"
		]
	},
	"private": true
}
