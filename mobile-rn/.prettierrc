{
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "trailingComma": "all",
  "tabWidth": 4,
  "useTabs": true,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "arrowParens": "avoid",
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/src/app/(.*)$",
    "^@/src/processes/(.*)$",
    "^@/src/pages/(.*)$",
    "^@/src/widgets/(.*)$",
    "^@/src/features/(.*)$",
    "^@/src/entities/(.*)$",
    "^@/srt/shared/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderCaseSensitive": false
}
