{
	"expo": {
		"name": "strollie",
		"slug": "strollie",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "ru.strollie",
		"splash": {
			"image": "./assets/images/icon-inkscape.png",
			"resizeMode": "contain",
			"backgroundColor": "#1BF57E"
		},
		"androidStatusBar": {
			"translucent": true
		},
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"bundleIdentifier": "ru.strollie",
			"supportsTablet": true,
			"config": {
				"usesNonExemptEncryption": false
			}
		},
		"android": {
			"package": "ru.strollie",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon-inkscape.png",
				"backgroundColor": "#1BF57E"
			},
			"edgeToEdgeEnabled": true
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			[
				"expo-build-properties",
				{
					"android": {
						"compileSdkVersion": 35,
						"targetSdkVersion": 35,
						"buildToolsVersion": "35.0.0"
					},
					"ios": {
						"deploymentTarget": "15.1"
					}
				}
			],
			"expo-router",
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/SuisseIntl-Regular.otf",
						"./assets/fonts/SuisseIntl-SemiBold.otf",
						"./assets/fonts/SuisseIntl-Bold.otf",
						"./assets/fonts/SuisseIntl-Medium.otf"
					]
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/icon-inkscape.png",
					"resizeMode": "contain",
					"backgroundColor": "#1BF57E",
					"imageWidth": 200
				}
			],
			[
				"expo-secure-store",
				{
					"configureAndroidBackup": true,
					"faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
				}
			],
			"expo-web-browser",
			[
				"react-native-edge-to-edge",
				{
					"android": {
						"parentTheme": "Default",
						"enforceNavigationBarContrast": false
					}
				}
			],
			[
				"expo-sensors",
				{
					"motionPermission": "Разрешить $(PRODUCT_NAME) доступ к датчикам движения для определения направления"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "5cdb6535-2c58-4cb2-a7a9-361760d645bf"
			}
		}
	}
}
