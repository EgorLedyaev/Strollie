{
  "expo": {
    "name": "strollie",
    "slug": "strollie",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ru.strollie",
    "splash": {
      "image": "./assets/images/icon_v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#1BF57E"
    },
    "androidStatusBar": {
      "translucent": true
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ru.strollie",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.strollie",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_v3.svg"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SuisseIntl-Regular.otf",
            "./assets/fonts/SuisseIntl-SemiBold.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_v3.svg",
          "resizeMode": "contain",
          "backgroundColor": "#1BF57E",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
