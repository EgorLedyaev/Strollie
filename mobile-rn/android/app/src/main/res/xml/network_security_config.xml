<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Config: scoped cleartext exception.
     Keep as narrow as possible and REMOVE after migrating to HTTPS.
     Allowed host: 91.108.246.148 (WebView fallback from webview.ts)
-->
<network-security-config>
    <!-- Default: disallow cleartext globally -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Explicitly allow ONLY the production fallback IP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">91.108.246.148</domain>
    </domain-config>
</network-security-config>
