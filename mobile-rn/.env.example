# Пример файла переменных окружения для Strollie
# Скопируйте этот файл в .env и заполните нужные значения.
# В репозиторий НЕ коммитить персональные/секретные ключи.
# Expo: только переменные с префиксом EXPO_PUBLIC_ попадают в клиент.

# === ПУБЛИЧНЫЕ URL/ХОСТЫ ===
# Прод/стейдж URL webview-карты или встроенного фронта (может быть http://host:port)
EXPO_PUBLIC_WEBVIEW_URL=http://YOUR_PROD_WEBVIEW_HOST

# Адрес сервиса построения маршрутов (Valhalla/BFF). Можно указать домен или host:port[/api/...]
# Если без схемы, код добавит http:// при обращении
EXPO_PUBLIC_ROUTE_API=localhost:8080/route

# === API КЛЮЧИ (ПУБЛИЧНЫЕ) ===
# Ключ 2GIS для геокодирования (ключ все равно экспонируется в клиенте — ограничьте его по доменам/IP в кабинете)
EXPO_PUBLIC_2GIS_API_KEY=YOUR_2GIS_PUBLIC_KEY

# === FEATURE FLAGS / MOCKS ===
# Включить мок загрузки аватара (true/false)
EXPO_PUBLIC_USE_MOCK_UPLOAD_AVATAR=true

# Режим моковой загрузки аватара: local | cdn
EXPO_PUBLIC_MOCK_UPLOAD_AVATAR_MODE=local

# Базовый CDN URL, используется если режим = cdn
EXPO_PUBLIC_MOCK_CDN_BASE=https://cdn.example.com/avatars

# === ДОПОЛНИТЕЛЬНЫЕ (добавляйте по мере надобности) ===
# EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.example.com/collect
# EXPO_PUBLIC_APPMETRICA_API_KEY=YOUR_APPMETRICA_KEY
# EXPO_PUBLIC_ANALYTICS_ENABLED=true
# EXPO_PUBLIC_ANALYTICS_DEBUG=false
# EXPO_PUBLIC_ANALYTICS_INCLUDE_CONTEXT=true
# EXPO_PUBLIC_SOME_FLAG=true

# После изменений перезапустите dev-сервер:
#   npm run clear  (очистка кеша) или npm start
